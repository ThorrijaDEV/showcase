# THE BOX — environment variables for local development
#
# Copy this file to .env and fill in your values. Never commit .env with real secrets.

# Public URL of your NVIDIA NIM proxy (Cloudflare Worker, Vercel Edge Function, etc.)
# The frontend calls this endpoint; the proxy holds the NVIDIA_API_KEY secret.
# Example: https://your-worker.your-subdomain.workers.dev/nim-explain
VITE_NIM_PROXY_URL=

# Deploy the proxy with NVIDIA_API_KEY set as a secret:
#   wrangler secret put NVIDIA_API_KEY   (Cloudflare Workers)
# Never put NVIDIA_API_KEY in this file or in the frontend.
